 265:CMSIS/Include/../include/core_cm4.h ****     uint32_t _reserved1:7;               /*!< bit: 20..26  Reserved */
 266:CMSIS/Include/../include/core_cm4.h ****     uint32_t Q:1;                        /*!< bit:     27  Saturation condition flag */
